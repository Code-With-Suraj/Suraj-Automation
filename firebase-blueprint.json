{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account registration metadata and role attributes",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "PurchaseRecord": {
      "title": "PurchaseRecord",
      "description": "Information about a product solution purchase made by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "integer" },
        "currency": { "type": "string" },
        "paymentId": { "type": "string" },
        "orderId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "productId", "paymentId", "status", "createdAt"]
    },
    "CustomProduct": {
      "title": "CustomProduct",
      "description": "Dynamically added automation product solution with codes and handbook guides",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "sheetTemplateUrl": { "type": "string" },
        "appsScriptCode": { "type": "string" },
        "setupSteps": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "images": {
          "type": "array",
          "items": { "type": "string" }
        },
        "marketPrice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "sheetTemplateUrl", "appsScriptCode", "setupSteps", "tagline", "description", "category", "color", "images", "createdAt"]
    },
    "ServiceReview": {
      "title": "ServiceReview",
      "description": "Client feedback and service ratings for Google search integration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "authorTitle": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "serviceUsed": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorName", "authorEmail", "rating", "comment", "isApproved", "createdAt"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "User requested dynamic project quotations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "hasLandingPage": { "type": "boolean" },
        "hasDynamicPages": { "type": "boolean" },
        "hasSheetsSync": { "type": "boolean" },
        "hasAppsScript": { "type": "boolean" },
        "hasWhatsAppNotification": { "type": "boolean" },
        "hasPdfGenerator": { "type": "boolean" },
        "hasDashboard": { "type": "boolean" },
        "hasAdminPanel": { "type": "boolean" },
        "hasMaintenance": { "type": "boolean" },
        "totalPrice": { "type": "integer" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "phone", "totalPrice", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles database"
    },
    "/purchases/{purchaseId}": {
      "schema": "PurchaseRecord",
      "description": "Verified transaction and purchase records database"
    },
    "/custom_products/{productId}": {
      "schema": "CustomProduct",
      "description": "Dynamically hosted custom product sheets and core script configurations"
    },
    "/reviews/{reviewId}": {
      "schema": "ServiceReview",
      "description": "Client reviews & testimonials collection for service ratings and rich search result displays"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Client dynamic quotations database"
    }
  }
}
