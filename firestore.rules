rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation functions
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 256
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Purchase record should be valid. Allowed fields must match the DB schemas exactly.
    function isValidPurchaseRecord(data) {
      return data.keys().hasAll(['userId', 'email', 'productId', 'productName', 'amount', 'currency', 'paymentId', 'orderId', 'status', 'createdAt'])
        && data.keys().size() == 10
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.productId is string && data.productId.size() <= 128
        && data.productName is string && data.productName.size() <= 256
        && data.amount is int
        && data.currency is string && data.currency.size() <= 10
        && data.paymentId is string && data.paymentId.size() <= 128
        && data.orderId is string && data.orderId.size() <= 128
        && data.status is string && data.status.size() <= 64
        && data.createdAt is timestamp;
    }

    // ServiceReview validation function
    function isValidReview(data) {
      return data.keys().hasAll(['id', 'authorName', 'authorEmail', 'authorPhotoURL', 'authorTitle', 'rating', 'comment', 'serviceUsed', 'isApproved', 'createdAt'])
        && data.keys().size() == 10
        && data.id is string && data.id.size() <= 128
        && data.authorName is string && data.authorName.size() <= 256
        && data.authorEmail is string && data.authorEmail.size() <= 256
        && data.authorPhotoURL is string && data.authorPhotoURL.size() <= 2048
        && data.authorTitle is string && data.authorTitle.size() <= 256
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 5000
        && data.serviceUsed is string && data.serviceUsed.size() <= 256
        && data.isApproved is bool
        && data.createdAt is timestamp;
    }

    // Quotation validation function
    function isValidQuotation(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'totalPrice', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.phone is string && data.phone.size() <= 100
        && data.totalPrice is int
        && data.status is string && data.status.size() <= 64
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['userId']) || data.userId is string)
        && (!data.keys().hasAny(['company']) || data.company is string)
        && (!data.keys().hasAny(['notes']) || data.notes is string)
        && (!data.keys().hasAny(['hasLandingPage']) || data.hasLandingPage is bool)
        && (!data.keys().hasAny(['hasDynamicPages']) || data.hasDynamicPages is bool)
        && (!data.keys().hasAny(['hasSheetsSync']) || data.hasSheetsSync is bool)
        && (!data.keys().hasAny(['hasAppsScript']) || data.hasAppsScript is bool)
        && (!data.keys().hasAny(['hasWhatsAppNotification']) || data.hasWhatsAppNotification is bool)
        && (!data.keys().hasAny(['hasPdfGenerator']) || data.hasPdfGenerator is bool)
        && (!data.keys().hasAny(['hasDashboard']) || data.hasDashboard is bool)
        && (!data.keys().hasAny(['hasAdminPanel']) || data.hasAdminPanel is bool)
        && (!data.keys().hasAny(['hasMaintenance']) || data.hasMaintenance is bool);
    }

    // BlogPost validation function
    function isValidBlogPost(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'summary', 'content', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 2048
        && data.slug is string && data.slug.size() <= 2048
        && data.summary is string && data.summary.size() <= 10000
        && data.content is string && data.content.size() <= 500000
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['category']) || data.category is string)
        && (!data.keys().hasAny(['image']) || data.image is string)
        && (!data.keys().hasAny(['tags']) || data.tags is list)
        && (!data.keys().hasAny(['readTime']) || data.readTime is string)
        && (!data.keys().hasAny(['isPublished']) || data.isPublished is bool)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    // BlogComment validation function
    function isValidBlogComment(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'content', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 256
        && data.content is string && data.content.size() <= 5000
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['userPhoto']) || data.userPhoto is string)
        && (!data.keys().hasAny(['parentId']) || data.parentId is string);
    }

    // Match users profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Match purchases history documents
    match /purchases/{purchaseId} {
      // User can only read their own purchase history
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Secure creation for authenticated owner
      allow create: if isSignedIn() 
        && isValidId(purchaseId)
        && isValidPurchaseRecord(incoming())
        && incoming().userId == request.auth.uid;
        
      // Purchases of a finalized payment details should be immutable
      allow update, delete: if false;
    }

    // Checking for administrator capabilities
    function isAdmin() {
      return isSignedIn() 
        && 'email' in request.auth.token 
        && request.auth.token.email.lower() == "surajsingh.noida98@gmail.com";
    }

    // Match dynamic custom products
    match /custom_products/{productId} {
      // Read is open to any user visiting the site
      allow read: if true;
      // Write (create, update, delete) is strictly restricted to verified admin
      allow create, update: if isAdmin() && isValidId(productId);
      allow delete: if isAdmin();
    }

    // Match service reviews
    match /reviews/{reviewId} {
      // Read approved reviews publicly, or any review by a verified admin
      allow read: if (resource.data.isApproved == true) || isAdmin();

      // Clients can create unapproved reviews. Admin can create pre-approved ones.
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && (
          (isAdmin()) || 
          (isSignedIn() && 'email' in request.auth.token && incoming().isApproved == false && incoming().authorEmail == request.auth.token.email)
        );

      // Only Admin can update or delete reviews
      allow update: if isAdmin() && isValidReview(incoming());
      allow delete: if isAdmin();
    }

    // Match service quotations
    match /quotations/{quotationId} {
      // Anyone can get their own quotation by ID to view/download PDF
      allow get: if true;
      // Listing are strictly restricted to admin users (for the panel)
      allow list: if isAdmin();
      
      // Anyone can create a quotation for their needs
      allow create: if isValidId(quotationId)
        && isValidQuotation(incoming());

      // Only Admin can update/delete quotations
      allow update: if isAdmin() && isValidQuotation(incoming());
      allow delete: if isAdmin();
    }

    // Match blog posts
    match /blogs/{blogId} {
      // Anyone can read blog posts if they are published, or if the user is a verified admin
      allow read: if (resource.data.isPublished == true) || isAdmin();
      
      // Only Admin can create, update, or delete blog posts
      allow create: if isAdmin() && isValidId(blogId) && isValidBlogPost(incoming());
      allow update: if isAdmin() && isValidBlogPost(incoming());
      allow delete: if isAdmin();

      // Nested subcollection for comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && isValidId(commentId)
          && isValidBlogComment(incoming())
          && incoming().userId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && isValidBlogComment(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == existing().createdAt;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }
  }
}
